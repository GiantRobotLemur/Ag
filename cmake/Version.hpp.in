///////////////////////////////////////////////////////////////////////////////
//! @file AppVersion.hpp
//! @brief A generated file specifying version information.
//! @author @APP_AUTHOR@
//! @date @CURRENT_YEAR@
//! @copyright @APP_COPYRIGHT@
///////////////////////////////////////////////////////////////////////////////

#ifndef HEADER_@headerGuard@_APP_VERSION_HPP_
#define HEADER_@headerGuard@_APP_VERSION_HPP_

///////////////////////////////////////////////////////////////////////////////
// Macro Definitions
///////////////////////////////////////////////////////////////////////////////
#define APP_MAJOR_VERSION @APP_VER_MAJOR@
#define APP_MINOR_VERSION @APP_VER_MINOR@
#define APP_REVISION @APP_VER_PATCH@
#define APP_BUILD @APP_VER_TWEAK@
#define APP_VERSION_TEXT "@APP_VERSION@"


#define APP_COMPANY "@APP_COMPANY@"
#define APP_PRODUCT_NAME "@PROJECT_NAME@"
#define APP_NAME "@APP_NAME@"
#define APP_DISPLAY_NAME "@APP_DISPLAY_NAME@"
#define APP_AUTHOR "@APP_AUTHOR@"
#define APP_DESCRIPTION "@APP_DESCRIPTION@"
#define APP_COPYRIGHT "@APP_COPYRIGHT@"
#define DEV_COMPONENT_DIR "@CMAKE_CURRENT_SOURCE_DIR@"
#define DEV_PROJECT_DIR "@CMAKE_SOURCE_DIR@"

// These macros can be used to create Ag::AppMetadata instances from the values
// encoded in this header.
#define MAKE_APP_METADATA() Ag::AppMetadata( \
    Ag::Version(APP_MAJOR_VERSION, APP_MINOR_VERSION, APP_REVISION, APP_BUILD), \
    APP_NAME, APP_DISPLAY_NAME, APP_DESCRIPTION, APP_COMPANY, APP_PRODUCT_NAME, \
    APP_AUTHOR, APP_COPYRIGHT)

#define MAKE_APP_METADATA_EX(x) Ag::AppMetadata( \
    Ag::Version(APP_MAJOR_VERSION, APP_MINOR_VERSION, APP_REVISION, x), \
    APP_NAME, APP_DISPLAY_NAME, APP_DESCRIPTION, APP_COMPANY, APP_PRODUCT_NAME, \
    APP_AUTHOR, APP_COPYRIGHT)

#endif
///////////////////////////////////////////////////////////////////////////////
